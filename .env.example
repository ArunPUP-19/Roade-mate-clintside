# ─── RouteMate Client Environment Variables ───────────────────────────
# Copy this file to .env and update the values as needed.
#
# VITE_API_BASE_URL — The backend API base URL (no trailing slash).
# Defaults to http://localhost:5000 if not set.
#
# Examples:
#   Local development:  VITE_API_BASE_URL=http://localhost:5000
#   Staging server:     VITE_API_BASE_URL=https://staging-api.routemate.com
#   Production:         VITE_API_BASE_URL=https://api.routemate.com
#   LAN testing:        VITE_API_BASE_URL=http://192.168.1.50:5000

VITE_API_BASE_URL=https://routemate-serverside.onrender.com
